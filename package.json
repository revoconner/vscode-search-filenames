{
  "name": "search-filenames",
  "displayName": "Search Filenames in explorer",
  "description": "Something to search filenames and not just inside files for vscode explorer. Cannot believe the default implementations are so bad.",
  "version": "1.6.0",
  "engines": {
        "vscode": "^1.85.0"
  },
    "author": {
    "name": "Rev"
  },
      "license": "unlicensed",
    "repository": {
      "type": "git",
      "url": "https://github.com/revoconner/vscode-search-filenames"
    },

  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "fileFilter.fileList",
          "name": "File Filter"
        }
      ]
    },
    "commands": [
      {
        "command": "fileFilter.search",
        "title": "Search Files",
        "icon": "$(search)"
      },
      {
        "command": "fileFilter.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "fileFilter.clear",
        "title": "Clear Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "fileFilter.toggleGitignore",
        "title": "Toggle Hide Ignored Files",
        "icon": "$(eye)"
      },
      {
        "command": "fileFilter.sortByName",
        "title": "Sort by Name"
      },
      {
        "command": "fileFilter.sortByPath",
        "title": "Sort by Path"
      },
      {
        "command": "fileFilter.sortByExtension",
        "title": "Sort by Extension"
      },
      {
        "command": "fileFilter.revealInExplorer",
        "title": "Reveal in File Explorer"
      },
      {
        "command": "fileFilter.copyPath",
        "title": "Copy Path"
      },
      {
        "command": "fileFilter.copyRelativePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "fileFilter.hashMD5",
        "title": "Copy MD5 Hash"
      },
      {
        "command": "fileFilter.hashSHA256",
        "title": "Copy SHA-256 Hash"
      },
      {
        "command": "fileFilter.hashSHA512",
        "title": "Copy SHA-512 Hash"
      },
      {
        "command": "fileFilter.hashSHA3",
        "title": "Copy SHA3-256 Hash"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fileFilter.search",
          "when": "view == fileFilter.fileList",
          "group": "navigation@1"
        },
        {
          "command": "fileFilter.refresh",
          "when": "view == fileFilter.fileList",
          "group": "navigation@2"
        },
        {
          "command": "fileFilter.clear",
          "when": "view == fileFilter.fileList",
          "group": "navigation@3"
        },
        {
          "command": "fileFilter.toggleGitignore",
          "when": "view == fileFilter.fileList",
          "group": "navigation@4"
        },
        {
          "command": "fileFilter.sortByName",
          "when": "view == fileFilter.fileList",
          "group": "sort@1"
        },
        {
          "command": "fileFilter.sortByPath",
          "when": "view == fileFilter.fileList",
          "group": "sort@2"
        },
        {
          "command": "fileFilter.sortByExtension",
          "when": "view == fileFilter.fileList",
          "group": "sort@3"
        }
      ],
      "view/item/context": [
        {
          "command": "fileFilter.revealInExplorer",
          "when": "view == fileFilter.fileList",
          "group": "navigation@1"
        },
        {
          "command": "fileFilter.copyPath",
          "when": "view == fileFilter.fileList",
          "group": "copy@1"
        },
        {
          "command": "fileFilter.copyRelativePath",
          "when": "view == fileFilter.fileList",
          "group": "copy@2"
        },
        {
          "command": "fileFilter.hashMD5",
          "when": "view == fileFilter.fileList",
          "group": "hash@1"
        },
        {
          "command": "fileFilter.hashSHA256",
          "when": "view == fileFilter.fileList",
          "group": "hash@2"
        },
        {
          "command": "fileFilter.hashSHA512",
          "when": "view == fileFilter.fileList",
          "group": "hash@3"
        },
        {
          "command": "fileFilter.hashSHA3",
          "when": "view == fileFilter.fileList",
          "group": "hash@4"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "sha3": "^2.1.4"
  }
}